# Copy this file to .env locally. Never commit real credentials.
PORT=10000
BASE_URL=http://localhost:10000

# Generate a long random secret, e.g. with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USER=admin
# Use a bcrypt hash generated for your chosen admin password, not a plaintext password.
ADMIN_PASS=replace-with-a-bcrypt-hash

RESEND_API_KEY=replace-with-your-resend-api-key
FROM_EMAIL=verified-sender@example.com
